@echo off
rem sk-vdisplay Windows camera sender: streams a webcam + mic to the Linux host over SRT.
rem Render this template (replace the @...@ values), save as C:\Tools\sk-cam.cmd, and
rem register one scheduled task per camera in the user's interactive session, e.g.
rem   SK-Cam-Front -> C:\Tools\sk-cam.cmd Front
rem Needs ffmpeg.exe (any build with libx264 + srt, e.g. gyan.dev essentials).
rem List device names with: ffmpeg -list_devices true -f dshow -i dummy
set CAM=%1
if "%CAM%"=="" set CAM=Front
@FFMPEG@ -hide_banner -loglevel warning ^
  -f dshow -rtbufsize 64M -video_size 1280x720 -framerate 30 -i video="@VIDEO_PREFIX@%CAM%@VIDEO_SUFFIX@" ^
  -f dshow -audio_buffer_size 50 -i audio="@MIC@" ^
  -map 0:v -map 1:a ^
  -c:v libx264 -preset ultrafast -tune zerolatency -g 30 -b:v 1500k -maxrate 1800k -bufsize 900k -pix_fmt yuv420p ^
  -c:a aac -b:a 96k -ar 48000 ^
  -f mpegts "srt://@HOST@:@PORT@?mode=caller&latency=500000" > "%~dp0sk-cam.log" 2>&1
