# A Windows PC pushes its webcam + mic over SRT (see windows/sk-cam.cmd.in).
LABEL="Windows"
SRC="srt://0.0.0.0:9710?mode=listener&latency=500000"
DEV=/dev/video10
AUDIO=1
# Optional: start/stop the sender remotely. $ARG = 3rd arg of `sk-cam windows on <arg>`.
ON_CMD='ssh winpc "schtasks /run /tn SK-Cam-${ARG:-Front}"'
OFF_CMD='ssh winpc "schtasks /end /tn SK-Cam-Front & schtasks /end /tn SK-Cam-Rear & taskkill /im ffmpeg.exe /f"'
